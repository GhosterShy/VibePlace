                            @section Map {
                                <script type="text/javascript">
                                    ymaps.ready(function () {
                                        const defaultCoords = [43.237163, 76.945645]; // Центр Алматы

                                        let myMap = new ymaps.Map("map", {
                                            center: defaultCoords,
                                            zoom: 15
                                        });

                                        let placemark;

                                        myMap.events.add('click', function (e) {
                                            const coords = e.get('coords');
                                            document.getElementById('AddressLink').value = coords.join(',');

                                            if (!placemark) {
                                                placemark = new ymaps.Placemark(coords, {}, { draggable: true });
                                                placemark.events.add('dragend', function () {
                                                    const newCoords = placemark.geometry.getCoordinates();
                                                    document.getElementById('AddressLink').value = newCoords.join(',');
                                                });
                                                myMap.geoObjects.add(placemark);
                                            } else {
                                                placemark.geometry.setCoordinates(coords);
                                            }
                                        });

                                        myMap.controls.add('zoomControl');
                                        myMap.controls.add('fullscreenControl');
                                    });
                                </script>
                            }




