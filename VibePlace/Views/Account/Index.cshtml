@{
    Layout = "_LayoutwithoutFooter";
}

@model AccountModel


<body class="overflow-hidden">
    <section class="flex justify-center relative">
        <img src="https://pagedone.io/asset/uploads/1702362010.png" alt="gradient background image" class="w-full h-full object-cover fixed">
        <div class="mx-auto max-w-lg px-6 lg:px-8 absolute py-20">
            <h1 class="mx-auto lg:mb-11 mb-8 text-center text-6xl font-extrabold">VibePlace</h1>
            <div class="rounded-2xl bg-white shadow-xl pb-10">
                <form asp-action="Index" asp-controller="Account" method="POST" class="px-10 pt-10 pb-2 mx-auto">
                    <div class="mb-10">
                        <h1 class="text-gray-900 text-center font-manrope text-3xl font-bold leading-10 mb-2">Welcome Back</h1>
                    </div>
                    <input asp-for="Login" type="tel" class="w-full h-10 text-gray-900 placeholder:text-gray-400 text-lg font-normal leading-7 rounded-xl border-gray-300 border focus:outline-none px-4 mb-2" placeholder="Email">
                    <input asp-for= "Password" type="text" class="w-full h-10 text-gray-900 placeholder:text-gray-400 text-lg font-normal leading-7 rounded-xl border-gray-300 border focus:outline-none px-4 mb-1" placeholder="Password">
                    <a href="forgot-passwd.html" class="flex justify-end mb-4">
                        <span class="text-indigo-600 text-right text-base font-normal leading-6">Forgot Password?</span>
                    </a>
                    <button type="submit" class="w-full h-12 text-white text-center text-base font-semibold leading-6 rounded-xl hover:bg-indigo-800 transition-all duration-700 bg-indigo-600 mb-2">Login</button>
                    <a href="@Url.Action("Register","Account")" class="flex justify-center text-gray-900 text-base font-medium leading-6">
                        Нет аккаунта? <span class="text-indigo-600 font-semibold pl-3"> Sign Up</span>
                    </a>
                </form>
                <div class="flex items-center rounded-full mx-10 mb-2">
                    <div class="flex-1 border-b border-gray-300"></div>
                    <span class="text-black text-lg font-semibold px-2">Или</span>
                    <div class="flex-1 border-b border-gray-300"></div>
                </div>

                <div style="display:flex;justify-content:center" class="px-10 mx-auto">
                    <a style="padding:10px" href="@Url.Action("Login","Account")" class="w-full h-10 text-white text-center text-base font-semibold leading-6 rounded-xl hover:bg-indigo-800 transition-all duration-700 bg-indigo-600"><i class="fa-brands fa-google"></i>&nbsp; Войти через Google</a>
                </div>
                
            </div>
        </div>
  
    </section>
</body>