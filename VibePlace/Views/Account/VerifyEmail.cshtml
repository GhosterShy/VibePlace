@model EmailVerificationModel


<div style="width:100%;display:flex;justify-content:center; margin:20px">
<div style="max-width:80%;min-width:50%">
        <form asp-action="VerifyEmail" class="">

    <div class="relative text-gray-500 focus-within:text-gray-900 mb-6">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none ">
            <svg width="20" height="16" viewBox="0 0 20 16" fill="none" xmlns="http://www.w3.org/2000/svg" class=" stroke-current ml-1">
                <path d="M1.87651 3.83325L6.79885 7.07932C8.55702 8.13423 9.43612 8.66169 10.402 8.6387C11.3678 8.61572 12.2208 8.04705 13.9268 6.90971L18.1232 3.83325M8.33317 14.6666H11.6665C14.8092 14.6666 16.3805 14.6666 17.3569 13.6903C18.3332 12.714 18.3332 11.1426 18.3332 7.99992C18.3332 4.85722 18.3332 3.28587 17.3569 2.30956C16.3805 1.33325 14.8092 1.33325 11.6665 1.33325H8.33317C5.19047 1.33325 3.61913 1.33325 2.64281 2.30956C1.6665 3.28587 1.6665 4.85722 1.6665 7.99992C1.6665 11.1426 1.6665 12.714 2.64281 13.6903C3.61913 14.6666 5.19047 14.6666 8.33317 14.6666Z" stroke="" stroke-width="1.5" stroke-linecap="round" />
            </svg>
        </div>
        <input asp-for="Email" type="text" id="default-search" class="block w-full h-11 pr-5 pl-12 py-2.5 text-base font-normal shadow-xs text-gray-900 bg-transparent border border-gray-300 rounded-full placeholder-gray-400 focus:outline-none" placeholder="example@gmail.com">
    </div>
            <span style="color:red;" asp-validation-for="Email"></span>
            <br />
            <br />
            <a href="@Url.Action("Index","Account")" class="text-indigo-600 text-base font-medium leading-6">Уже есть аккаунт?</a>
   
    <div class="flex mt-7 mb-5">
        <button type="submit" class="w-full h-12 bg-indigo-600 hover:bg-indigo-900 transition-all duration-700 rounded-full shadow-xs text-white text-base font-semibold leading-6">Отправить код</button>
    </div>
    <div class="flex w-full items-center space-x-4 mt-10 mb-10">
        <div class="flex-1 border-b border-gray-200"></div>
        <span class="flex items-center justify-center text-gray-400 text-lg font-normal leading-7 px-5">OR</span>
        <div class="flex-1 border-b border-gray-200"></div>
    </div>
    <p class="text-gray-900 text-center text-base font-medium leading-6 mb-3">Регистрация через другие сервисы</p>
            <div style="display:flex;justify-content:center;align-items:center">
                <a style="padding-top:7px" href="@Url.Action("Login","Account")" class="w-full h-10 text-white text-center text-base font-semibold leading-6 rounded-xl hover:bg-indigo-800 transition-all duration-700 bg-indigo-600">&nbsp; Войти через Google</a>
            </div>
           
</form>
        
</div>
</div>