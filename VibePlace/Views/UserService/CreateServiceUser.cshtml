@using VibePlace.Data.Models
@model UserService
@{
    ViewData["Title"] = "Добавить услугу";
}

<h2 style="text-align:center" class="text-gray-900 text-4xl font-extrabold md:text-5xl lg:text-6xl">
    Заполните форму <span class="text-transparent bg-clip-text bg-gradient-to-r to-indigo-600 from-violet-400">Услуги</span>
</h2>
<div style="display:flex;justify-content:center;align-items:center;width:100%;margin-top:20px">
    <form style="padding:20px" method="post" asp-action="CreateServiceUser" enctype="multipart/form-data">
    
    <div class="grid md:grid-cols-2 grid-cols-1 gap-x-8">
        <div class="relative mb-6">
            <input asp-for="Number"  id="default-search" class="block w-full h-11 px-5 py-2.5 bg-white leading-7 text-base font-normal shadow-xs text-gray-900 bg-transparent border border-gray-300 rounded-full placeholder-gray-400 focus:outline-none " placeholder="Номер телефона..." required="">
        </div>
        <div class="relative mb-6">
            <input asp-for="Price" id="default-search" class="block w-full h-11 px-5 py-2.5 bg-white leading-7 text-base font-normal shadow-xs text-gray-900 bg-transparent border border-gray-300 rounded-full placeholder-gray-400 focus:outline-none " placeholder="Цена(KZ)..." required="">
        </div>
    </div>


    <div class="block w-full">
        <select asp-for="ServiceId" asp-items="ViewBag.Services" multiple id="countries" size="3" class="h-auto border border-gray-300 text-gray-600 text-base rounded-lg block w-full py-2.5 px-4 focus:outline-none">
            <option selected>Выберите услугу</option>
        </select>
    </div>



    <div style="margin-top:20px" class="relative mb-6">
        <textarea asp-for="Description" type="text" id="default-search" class="block w-full h-40 px-5 py-2.5 bg-white leading-7 resize-none text-base font-normal shadow-xs text-gray-900 bg-transparent border border-gray-300 rounded-2xl placeholder-gray-400 focus:outline-none " placeholder="Описание..." required=""></textarea>
    </div>


        <div class="w-full flex-col justify-start items-start gap-2.5 flex">
            <label for="dropzone-file" class="flex flex-col items-center justify-center py-9 w-full border border-gray-300 border-dashed rounded-2xl cursor-pointer bg-gray-50 ">
                <div class="mb-3 flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
                        <g id="Upload 02">
                            <path id="icon" d="M16.296 25.3935L19.9997 21.6667L23.7034 25.3935M19.9997 35V21.759M10.7404 27.3611H9.855C6.253 27.3611 3.33301 24.4411 3.33301 20.8391C3.33301 17.2371 6.253 14.3171 9.855 14.3171V14.3171C10.344 14.3171 10.736 13.9195 10.7816 13.4326C11.2243 8.70174 15.1824 5 19.9997 5C25.1134 5 29.2589 9.1714 29.2589 14.3171H30.1444C33.7463 14.3171 36.6663 17.2371 36.6663 20.8391C36.6663 24.4411 33.7463 27.3611 30.1444 27.3611H29.2589" stroke="#4F46E5" stroke-width="1.6" stroke-linecap="round" />
                        </g>
                    </svg>
                </div>
                <span class="text-center text-gray-400 text-xs font-normal leading-4 mb-1">PNG, JPG or PDF, smaller than 15MB</span>
                <h6 class="text-center text-gray-900 text-sm font-medium leading-5">ОБЛОЖКА</h6>
                <input name="Image" id="dropzone-file" type="file" class="hidden" />
            </label>
        </div>
       

    <div style="margin-top:20px" class="flex items-center justify-center">
        <button type="submit" class="w-52 h-12 bg-indigo-600 hover:bg-indigo-800 transition-all duration-700 rounded-full shadow-xs text-white text-base font-semibold leading-6">Подвердить</button>
    </div>

</form>

</div>
