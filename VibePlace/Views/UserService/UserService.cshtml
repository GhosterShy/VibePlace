@using VibePlace.Data.Models
@model UserService



@section Style{
.address-product {
transition: all .3s;
}
.address-product:hover {
scale: 1.015;
background-color: #FEF3C7;
}
@@keyframes appear {
from {
opacity: 0;
transform: translateX(-80px);
/* scale: 0.5; */
}
to {
opacity: 1;
transform: translateX(0px);
/* scale: 1; */
}
}
@@keyframes appear-right {
from {
opacity: 0;
transform: translateX(80px);
/* scale: 0.5; */
}
to {
opacity: 1;
transform: translateX(0px);
/* scale: 1; */
}
}
@@keyframes appear-scale {
from {
opacity: 0;
scale: 0.5;
}
to {
opacity: 1;
scale: 1;
}
}
.animation-product {
animation: appear linear;
animation-timeline: view();
animation-range: entry 0% cover 30%;
}
.animation-product-right {
animation: appear-right linear;
animation-timeline: view();
animation-range: entry 0% cover 30%;
}
.animation-product-scale {
animation: appear-scale linear;
animation-timeline: view();
animation-range: entry 0% cover 30%;
}
}

<main class="max-w-7xl mx-auto pb-6">


    <nav class="flex mt-3 mb-6 px-2 md:px-0" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="javascript:;" class="inline-flex items-center text-base font-medium text-gray-900 hover:text-indigo-800">Home</a>
            </li>
            <li>
                <div class="flex items-center">
                    <svg class="mx-1 w-5 h-5" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 15L11.0858 11.4142C11.7525 10.7475 12.0858 10.4142 12.0858 10C12.0858 9.58579 11.7525 9.25245 11.0858 8.58579L7.5 5" stroke="#E5E7EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <a href="javascript:;" class="ml-1 text-base font-medium text-gray-900 hover:text-indigo-800 md:ml-2">@Model.Service.Name</a>
                </div>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <svg class="mx-1 w-5 h-5" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 15L11.0858 11.4142C11.7525 10.7475 12.0858 10.4142 12.0858 10C12.0858 9.58579 11.7525 9.25245 11.0858 8.58579L7.5 5" stroke="#E5E7EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="ml-1 text-base font-medium text-indigo-600 md:ml-2 ">@Model.User.UserName</span>
                </div>
            </li>
        </ol>
    </nav>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 px-2 md:px-0">
        <div class="col-span-2 row-span-2">
            <img class="w-full h-full object-cover rounded-lg" src="@Url.Action("GetImageService", "UserService", new { Model.Id})" />
        </div>



        <div class="grid col-span-2 row-span-2 grid-rows-3 grid-flow-col gap-4 text-white text-sm text-center font-bold leading-6">
            
            <div class="p-4 rounded-lg  bg-indigo-300 grid place-content-center col-span-2 ">
                <h2 class="text-gray-900 text-4xl font-extrabold md:text-5xl lg:text-6xl">
                    Описание  <span class="text-transparent bg-clip-text bg-gradient-to-r to-indigo-600 from-violet-400">Услуги</span>
                </h2>
            </div>
            <div class="p-4 rounded-lg shadow-lg  grid place-content-center row-span-2 col-span-2">
                <p class="text-gray-900 mb-3">@Model.Description</p>
            </div>
        </div>

        <!--Images-->
       

       



    </div>
    <div class="px-2 md:px-0">
        <div class="flex w-full items-center rounded-full animation-product-scale">
            <div class="flex-1 border-b border-gray-400"></div>
            <span class="text-black font-bold text-3xl leading-10 px-4 md:px-8 py-10">@Model.User.UserName</span>
            <div class="flex-1 border-b border-gray-400"></div>
        </div>

        <div class="grid grid-cols-1">
            <div class="">
               
                <div class="flex items-center gap-3 bg-blue-200 rounded-3xl mb-3 animation-product">
                    <img src="~/img/UserAva/UserImage.jpg" alt="Hailey image" class="w-12 h-12">
                    <div>
                        <h2 class="text-gray-500 text-sm font-medium leading-snug pb-0.5">
                            Имя:
                            <span class="text-gray-900">@Model.User.UserName</span>
                        </h2>
                       
                    </div>

                    
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-2 animation-product">
                    
                    <div class="bg-blue-200 rounded-2xl p-2 animation-product">
                        <h2 class="text-gray-500 text-sm font-medium leading-snug pb-0.5">
                            Услуга:
                           
                                <span class="text-gray-900">@Model.Service.Name</span>
                           
                        </h2>
                    </div>
                   
                    <div class="bg-blue-200 rounded-2xl flex flex-col justify-between p-2 relative animation-product">
                        <div class="py-1">
                            <kbd class="px-4 py-2 text-xl font-semibold text-gray-900 bg-blue-100 rounded-xl">@Model.Price тг</kbd>
                            <span class="text-ld">средняя услуга</span>
                        </div>
                       
                    </div>
                </div>


                </div>

            <div style="margin-top:20px" class="bg-blue-200 rounded-2xl flex flex-col justify-between p-2 relative animation-product">
                <div class="py-1">
                    <kbd class="px-4 py-2 text-xl font-semibold text-gray-900 bg-blue-100 rounded-xl">Номер телефона:</kbd>
                    <span class="text-ld">@Model.Number</span>
                </div>

            </div>



               
                @* <iframe class="w-full h-full rounded-2xl md:h-full" style="border:0" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps/embed/v1/place?key=AIzaSyAOVYRIgupAurZup5y1PRh8Ismb1A3lLao&q=@Model.places.Address,Seattle"></iframe> *@
            </div>
        </div>

        <div class="flex w-full items-center rounded-full animation-product-scale">
            <div class="flex-1 border-b border-gray-300"></div>
            <span class="text-black text-2xl font-semibold leading-8 px-4 py-10">Отзывы</span>
            <div class="flex-1 border-b border-gray-300"></div>
        </div>

       






        <section class="relative">


            <div class="w-full max-w-7xl mx-auto">
                <div class="w-full flex-col justify-start items-start lg:gap-14 gap-7 inline-flex">
                    <div id="reviews" class="w-full flex-col justify-start items-start gap-8 flex">
                    @if (Model.Reviews != null) 
                   { 
                       @foreach (var review in Model.Reviews) 
                       { 
                           <div class="w-full lg:p-8 p-5 bg-white rounded-3xl border border-gray-200 flex-col justify-start items-start flex animation-product"> 
                               <div class="w-full flex-col justify-start items-start gap-3.5 flex"> 
                                   <div class="w-full justify-between items-center inline-flex"> 
                                       <div class="justify-start items-center gap-2.5 flex"> 
                                           <div class="w-10 h-10 bg-stone-300 rounded-full justify-start items-start gap-2.5 flex"> 
                                               <img class="rounded-full object-cover" src="~/img/UserAva/UserImage.jpg" 
                                               alt="John smith image" /> 
                                           </div> 
                                           <div class="flex-col justify-start items-start gap-1 inline-flex"> 
                                               <h5 class="text-gray-900 text-sm font-semibold leading-snug">@review.User.UserName</h5> 
                                               <h6 class="text-gray-500 text-xs font-normal leading-5">@review.CreatedAt</h6> 
                                           </div> 
                                       </div> 
                                       <div class="group justify-end items-center flex"> 
                                           <div class="px-5 py-2.5 rounded-xl shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] border border-gray-400 hover:border-green-600 transition-all duration-700 ease-in-out justify-center items-center flex"> 
                                            
                                                   <a hx-get="@Url.Action("PlusLike", "PlaceInfo", new {review.Id})" hx-target="#like_@review.Id" hx-swap="innerHTML" class=""> 
                                                   <svg class="group-hover:text-green-600 text-gray-400 group-hover:fill-green-600 fill-white transition-all duration-700 ease-in-out" 
                                                   xmlns="http://www.w3.org/2000/svg" width="20" height="20" 
                                                   viewBox="0 0 20 20" fill="none"> 
                                                       <path d="M2.62629 3.43257C4.64001 1.44869 7.82082 1.31134 9.99614 3.02053C12.1723 1.31134 15.3589 1.44869 17.3726 3.43257L17.3734 3.43334C19.5412 5.57611 19.5412 9.04382 17.3804 11.1867L17.378 11.1891L10.4631 17.9764C10.2035 18.2312 9.78765 18.2309 9.52844 17.9758L2.62629 11.1821C0.457252 9.04516 0.457252 5.56947 2.62629 3.43257Z" 
                                                       stroke="currentColor" /> 
                                                   </svg> 
                                                    </a> 
                                               <div class="px-2 justify-center items-center flex"> 
                                                   <h5 id="like_@review.Id" class="group-hover:text-green-600 text-gray-400 transition-all duration-700 ease-in-out text-base font-semibold leading-relaxed"> 
                                                          @review.Like 
                                                   </h5> 
                                               </div>
                                           </div> 
                                       </div> 
                                   </div> 
                                   <p class="text-gray-800 text-sm font-normal leading-snug"> 
                                       @review.Comment 
                                   </p> 
                               </div> 
                           </div> 
                       } 

                     }

                        
                        <div class="w-full relative flex justify-between gap-2 animation-product">
                            <form style="width:100%" asp-action="AddReview" method="post">
                                <input name="Comment" type="text"
                                   class="w-full py-3 px-5 rounded-lg border border-gray-300 bg-white shadow-[0px_1px_2px_0px_rgba(16,_24,_40,_0.05)] focus:outline-none text-gray-900 placeholder-gray-400 text-lg font-normal leading-relaxed"
                                   placeholder="Leave a constructive comment...">
                                <input type="hidden" name="UserServiceId" value="@Model.Id">
                            <button type="submit" href="" class="absolute right-6 top-3.5">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"
                                     fill="none">
                                    <g clip-path="url(#clip0_2063_2504)">
                                        <path d="M10.0194 1.66699V5.6556C1.69526 5.6556 1.54178 14.4163 1.69573 18.3337C1.69573 16.4818 5.84659 10.0003 10.0194 10.6414V14.63L18.3332 8.14847L10.0194 1.66699Z"
                                              stroke="#111827" stroke-width="1.6" stroke-linejoin="round" />
                                    </g>
                                    <defs>
                                        <clipPath id="clip0_2063_2504">
                                            <rect width="20" height="20" fill="white" />
                                        </clipPath>
                                    </defs>
                                </svg>
                            </button>
                            </form>
                        </div>
                        
                    </div>
                </div>
            </div>
        </section>


    </div>

</main>
