@using VibePlace.Data
@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> _userManager
@inject SignInManager<AppUser> _signInManager


@{
    var currentUser = await _userManager.GetUserAsync(User);
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="~/Icons/Icon.png" type="image/png">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=person" />

    <link href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/pagedone@1.2.2/src/css/pagedone.css" rel="stylesheet" />
    <script src="https://unpkg.com/htmx.org@2.0.4" integrity="sha384-HGfztofotfshcF7+8n44JQL2oJmowVChPTg48S+jvZoztPfvwD79OC/LTtG6dMp+" crossorigin="anonymous"></script>
    <script src="https://api-maps.yandex.ru/2.1/?apikey=3cd5a066-de3d-4c35-862b-ab6b2fac082f&lang=ru_RU" type="text/javascript"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    @RenderSection("Map",required:false)

    <link rel="stylesheet" href="~/css/site.css">




    <title>VibePlace / Home</title>
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Geologica:wght@100..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Outfit:wght@100..900&display=swap');

        body {
        font-family: Geologica;
        }
        .no-copy {
        -webkit-user-select: none; /* Safari */
        -moz-user-select: none; /* Firefox */
        -ms-user-select: none; /* IE 10+ */
        user-select: none; /* Standard syntax */
        }

        .pointer {
        cursor: pointer;
        }
        @@keyframes appear {
        from


        {
        opacity: 0;
        transform: translateX(-100px);
        /* scale: 0.5; */
        }

        to {
        opacity: 1;
        transform: translateX(0px);
        /* scale: 1; */
        }

        }

        .grid-item-home, .pagination-home, .new-org-home, .footer-vibeplace, .footer-ul {
        animation: appear linear;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
        }


        @RenderSection("Style",required:false)
    </style
</head>
<body>
    <!-- Header Start -->
    <nav class="py-5  transition-all duration-500 w-full bg-white border-b border-solid border-gray-200">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="w-full flex  flex-col lg:flex-row lg:items-center lg:justify-between">
                <div class=" flex justify-between  lg:flex-row">
                    <a href="javascript:;" class="flex items-center font-extrabold text-2xl">VibePlace</a>
                    <button data-collapse-toggle="navbar-default" type="button" class="inline-flex items-center p-2 ml-3 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 " aria-controls="navbar-default" aria-expanded="false">
                        <span class="sr-only">Open main menu</span>
                        <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path>
                        </svg>
                    </button>


                </div>




                <div class="hidden w-full lg:flex lg:pl-11 " id="navbar-default">
                    <ul class="lg:flex items-center flex-col mt-4 lg:mt-0 lg:flex-row lg:ml-auto">

                    

                        @if (currentUser != null && await _userManager.IsInRoleAsync(currentUser, "Organizator"))
                        {
                            <li>
                                <a href="@Url.Action("Index","Organizator")" class="nav-link mb-2 block lg:mr-6 md:mb-0 lg:text-left text-center">@localizer["Main"]<a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@Url.Action("Index","Home")" class="nav-link mb-2 block lg:mr-6 md:mb-0 lg:text-left text-center">@localizer["Main"]<a>
                            </li>
                        }
                        <li>
                            <a href="@Url.Action("Service","Service")" class="nav-link mb-2 block lg:mr-6 md:mb-0 lg:text-left text-center">@localizer["Services"]</a>
                        </li>
                        <li>
                            <a href="@Url.Action("Contacts", "Contacts")" class="nav-link mb-2 block lg:mr-6 md:mb-0 lg:text-left text-center">@localizer["Contacts"]<a>
                        </li>

                        @if (_signInManager.IsSignedIn(User) && await _userManager.IsInRoleAsync(await _userManager.GetUserAsync(User), "Organizator"))
                        {
                            <li>
                                <a href="@Url.Action("Index", "Organizator")" class="nav-link mb-2 block lg:mr-6 md:mb-0 lg:text-left text-center">@localizer["MyPlace"]<a>
                            </li>
                        }



                        <!--Search-->
                      <div  class="hidden w-full lg:flex mt-8 lg:mt-0 item-center justify-end lg:pl-11 " id="navbar-with-form">
                          <form asp-action="SearchPlace" asp-controller="Place" class="flex items-center max-lg:justify-center gap-0">
                              <div class="relative">
                                  <input name="query" type="search" id="default-search"
                                      class="block w-full max-w-xs px-4 py-2 text-sm font-normal shadow-xs text-gray-900 bg-transparent border border-gray-300 rounded-lg placeholder-gray-400 focus:outline-none leading-relaxed"
                                      placeholder="search " required="">
                              </div>
                              <button class="p-1 px-2" type="submit">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                                      <path
                                          d="M21 21L18.5 18.5M19 11C19 6.58172 15.4183 3 11 3C6.58172 3 3 6.58172 3 11C3 15.4183 6.58172 19 11 19C13.2006 19 15.1937 18.1115 16.6401 16.6736C18.0976 15.2246 19 13.2177 19 11Z"
                                          stroke="black" stroke-width="1.6" stroke-linecap="round"></path>
                                  </svg>
                              </button>
                          </form>
                      </div>


                    </ul>
                    <div class="flex items-center justify-center">
                        <div class="dropdown relative inline-flex z-10">
                            <button type="button" data-target="dropdown-with-divider" class="dropdown-toggle inline-flex justify-center items-center gap-2 py-3 px-6 text-sm bg-indigo-600 text-white rounded-full cursor-pointer font-semibold text-center shadow-xs transition-all duration-500 hover:bg-indigo-700 ">
                                @if (User.Identity.IsAuthenticated) {
                                    <font>@User.Identity.Name</font>
                                }
                                else {
                                    <font>Username</font>
                                }
                            </button>
                            <div id="dropdown-with-divider" class="dropdown-menu hidden bg-slate-400 rounded-xl shadow-lg  absolute right-0 top-full w-48 mt-2 divide-y divide-gray-200" aria-labelledby="dropdown-with-divider">
                                <ul class="py-2">
                                    <li>
                                        @if (User.Identity.IsAuthenticated)
                                        {
                                            <a class="block px-6 py-2 hover:bg-gray-100 text-gray-900 font-medium" href="@Url.Action("profile","Account")">@User.Identity.Name</a>
                                        }
                                        else{
                                            <a class="block px-6 py-2 hover:bg-gray-100 text-gray-900 font-medium" href="@Url.Action("VerifyEmail","Account")">Регистрация</a>
                                            <a class="block px-6 py-2 hover:bg-gray-100 text-gray-900 font-medium" href="@Url.Action("Index","Account")">Авторизация</a>
                                        }

                                    </li>

                                    <li>
                                        <a class="block px-6 py-2 hover:bg-gray-100 text-gray-900 font-medium" href="javascript:;"> Центр помощи </a>
                                    </li>
                                </ul>
                                @if(User.Identity.IsAuthenticated)
                                {
                                   <div class="py-2">
                                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                                        <button style="padding-left:20px" type="submit" class="nav-link">Logout</button>
                                    </form>
                                   </div>
                                }
                               
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
    <!-- Header End -->

@RenderBody()

    <!-- Footer Start -->
    <footer class="w-full py-14 bg-slate-400">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl mx-auto">
                <a href="#" class="flex justify-center text-4xl font-extrabold footer-vibeplace">VibePlace</a>
                <ul class="text-lg flex items-center justify-center flex-col gap-7 md:flex-row md:gap-12 transition-all duration-500 py-16 mb-10 border-b border-gray-200 footer-ul">
                    <li><a href="#" class="text-gray-800 hover:text-gray-900">Главная</a></li>
