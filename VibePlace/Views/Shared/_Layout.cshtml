      <!-- Bot -->



      

    <div class="chat-toggle" id="chat-toggle">
        <img src="https://img.icons8.com/ios-filled/50/ffffff/chat.png" alt="Chat Icon" class="chat-toggle-img" />
    </div>

    <div class="chat-container" id="chat-container">
        <div class="chat-header">
            <div class="status">
                <div class="header-avatar">VP</div>
                <span class="bot-name">VibePlace Bot</span>
                <span id="availability">24/7</span>
            </div>
            <span class="settings">⋮</span>
            <div class="settings-menu" id="settings-menu">
                <div class="menu-item">
                    <span>🔊 Звук вкл.</span>
                    <label class="switch">
                        <input type="checkbox" id="sound-toggle" checked>
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="menu-item">
                    <span>🌙 Темный режим</span>
                    <label class="switch">
                        <input type="checkbox" id="theme-toggle">
                        <span class="slider"></span>
                    </label>
                </div>
                <div class="menu-item whatsapp-btn" id="whatsapp-btn">
                    <img src="https://img.icons8.com/color/24/000000/whatsapp.png" alt="WhatsApp Icon">
                    <span>Продолжить в WhatsApp</span>
                </div>
            </div>
        </div>

        <div class="chat-messages" id="chat-messages">
            <!-- Сообщения здесь -->
        </div>

        <div class="chat-input">
            <img src="https://img.icons8.com/ios-glyphs/30/000000/attach.png" alt="Attach" id="attach-btn">
            <input type="text" id="message-input" placeholder="Введите сообщение">
            <img src="https://img.icons8.com/ios-glyphs/30/000000/paper-plane.png" alt="Send" id="send-btn" style="display: none;">
            <input type="file" id="file-input" style="display: none;" accept="image/*">
        </div>

        <!-- Шаблон для категорий -->
        <template id="topic-template-kz">
            <button class="topic-btn" onclick="selectTopic('Іс-шара түрі')">Іс-шара түрі</button>
            <button class="topic-btn" onclick="selectTopic('Орын түрі')">Орын түрі</button>
            <button class="topic-btn" onclick="selectTopic('Аудитория бойынша')">Аудитория бойынша</button>
            <button class="topic-btn" onclick="selectTopic('Танымал')">Танымал</button>
            <button class="topic-btn" onclick="selectTopic('Ассистент бот')">Ассистент бот</button>
        </template>
        <template id="topic-template-ru">
            <button class="topic-btn" onclick="selectTopic('Тип мероприятия')">Тип мероприятия</button>
            <button class="topic-btn" onclick="selectTopic('Тип места')">Тип места</button>
            <button class="topic-btn" onclick="selectTopic('По аудитории')">По аудитории</button>
            <button class="topic-btn" onclick="selectTopic('Популярное')">Популярное</button>
            <button class="topic-btn" onclick="selectTopic('Ассистент бот')">Ассистент бот</button>
        </template>
        <template id="topic-template-en">
            <button class="topic-btn" onclick="selectTopic('Event Type')">Event Type</button>
            <button class="topic-btn" onclick="selectTopic('Place Type')">Place Type</button>
            <button class="topic-btn" onclick="selectTopic('By Audience')">By Audience</button>
            <button class="topic-btn" onclick="selectTopic('Popular')">Popular</button>
            <button class="topic-btn" onclick="selectTopic('Assistant Bot')">Assistant Bot</button>
        </template>

        <!-- Шаблон для подкатегорий (Іс-шара түрі / Тип мероприятия / Event Type) -->
        <template id="sub-topic-template-kz-event-type">
            <div class="message received">Қандай іс-шара түрі туралы білгіңіз келеді?</div>
            <div class="topic-selection">
                <button class="topic-btn" onclick="selectSubTopic('Туған күн')">Туған күн</button>
                <button class="topic-btn" onclick="selectSubTopic('Үйлену тойы')">Үйлену тойы</button>
                <button class="topic-btn" onclick="selectSubTopic('Корпоратив')">Корпоратив</button>
                <button class="topic-btn" onclick="selectSubTopic('Іскерлік кездесулер')">Іскерлік кездесулер</button>
                <button class="topic-btn" onclick="selectSubTopic('Мерейтой')">Мерейтой</button>
            </div>
        </template>
        <template id="sub-topic-template-ru-event-type">
            <div class="message received">О каком типе мероприятия хотите узнать?</div>
            <div class="topic-selection">
                <button class="topic-btn" onclick="selectSubTopic('День рождения')">День рождения</button>
                <button class="topic-btn" onclick="selectSubTopic('Свадьба')">Свадьба</button>
                <button class="topic-btn" onclick="selectSubTopic('Корпоратив')">Корпоратив</button>
                <button class="topic-btn" onclick="selectSubTopic('Деловые встречи')">Деловые встречи</button>
                <button class="topic-btn" onclick="selectSubTopic('Юбилей')">Юбилей</button>
            </div>
        </template>
