@using VibePlace.Data.Models
@model UserToService


@section Script
{
    <script>
        const tabLinks = document.querySelectorAll('.filter');

        tabLinks.forEach(link => {
            link.addEventListener('click', () => {
               
                tabLinks.forEach(tab => tab.classList.remove('active', 'bg-indigo-500', 'text-white', 'rounded-xl'));

                link.classList.add('active', 'bg-indigo-500', 'text-white', 'rounded-xl');
            });
        });


    </script>
}


<main class="max-w-7xl mx-auto pb-6">
    <nav class="flex mt-3 mb-6 px-2 md:px-0" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
            <li class="inline-flex items-center">
                <a href="javascript:;" class="inline-flex items-center text-base font-medium text-gray-900 hover:text-indigo-800">Home</a>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <svg class="mx-1 w-5 h-5" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M7.5 15L11.0858 11.4142C11.7525 10.7475 12.0858 10.4142 12.0858 10C12.0858 9.58579 11.7525 9.25245 11.0858 8.58579L7.5 5" stroke="#E5E7EB" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="ml-1 text-base font-medium text-indigo-600 md:ml-2 ">Услуги</span>
                </div>
            </li>

        </ol>
    </nav>




    <div class="tabs">
        <div class="flex ">

            <ul class="flex flex-wrap transition-all duration-300 overflow-hidden">

                <li>
                    <a hx-get="@Url.Action("FilterService", "Service", new { serviceid = 0000 })" hx-target="#services_container" hx-swap="innerHTML"
                       class="filter inline-block py-3 px-6 text-gray-500 hover:text-gray-800 font-medium"
                       data-tab="tabs-with-rounded-light-000">All</a>
                </li>

                @foreach(Service item in Model.Services)
                {

                    <li>
                        <a hx-get="@Url.Action("FilterService", "Service", new { serviceid = item.Id })" hx-target="#services_container" hx-swap="innerHTML"
                           class="filter inline-block py-3 px-6 text-gray-500 hover:text-gray-800 font-medium"
                           data-tab="tabs-with-rounded-light-@item.Name">@localizer[$"{@item.Name}"]</a>
                    </li>
                }
                
               
            </ul>
        </div>

        <div class="mt-3">

            <div  class="tabcontent min-h-screen">
                <div class="w-full relative flex items-center justify-center h-auto mb-3">


                    <div id="services_container" class="grid grid-cols-1 px-2 md:px-0 md:grid-cols-4 gap-5">



                @foreach(UserService? userService in Model.UsersServices)
                {
							<div class="rounded-xl bg-white shadow-lg shadow-gray-300 overflow-hidden relative grid-item-home">
								<a href="@Url.Action("UserService","UserService",new {id = userService.Id})" class="absolute opacity-0 h-full w-full rounded-xl"></a>
                                <img src="@Url.Action("GetImageService","UserService",new {userService.Id})" alt="image">
								<div class="flex items-center absolute gap-2 top-2 right-3">
									<svg width="20" height="20" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg">
										<g clip-path="url(#clip0_13866_9712)">
											<path d="M14.1033 2.56698C14.4701 1.82374 15.5299 1.82374 15.8967 2.56699L19.1757 9.21093C19.3214 9.50607 19.6029 9.71064 19.9287 9.75797L27.2607 10.8234C28.0809 10.9426 28.4084 11.9505 27.8149 12.5291L22.5094 17.7007C22.2737 17.9304 22.1662 18.2614 22.2218 18.5858L23.4743 25.8882C23.6144 26.7051 22.7569 27.3281 22.0233 26.9424L15.4653 23.4946C15.174 23.3415 14.826 23.3415 14.5347 23.4946L7.9767 26.9424C7.24307 27.3281 6.38563 26.7051 6.52574 25.8882L7.7782 18.5858C7.83384 18.2614 7.72629 17.9304 7.49061 17.7007L2.1851 12.5291C1.59159 11.9505 1.91909 10.9426 2.73931 10.8234L10.0713 9.75797C10.3971 9.71064 10.6786 9.50607 10.8243 9.21093L14.1033 2.56698Z" fill="#F3F4F6"></path>
											<g clip-path="url(#clip1_13866_9712)">
												<path d="M14.1033 2.56698C14.4701 1.82374 15.5299 1.82374 15.8967 2.56699L19.1757 9.21093C19.3214 9.50607 19.6029 9.71064 19.9287 9.75797L27.2607 10.8234C28.0809 10.9426 28.4084 11.9505 27.8149 12.5291L22.5094 17.7007C22.2737 17.9304 22.1662 18.2614 22.2218 18.5858L23.4743 25.8882C23.6144 26.7051 22.7569 27.3281 22.0233 26.9424L15.4653 23.4946C15.174 23.3415 14.826 23.3415 14.5347 23.4946L7.9767 26.9424C7.24307 27.3281 6.38563 26.7051 6.52574 25.8882L7.7782 18.5858C7.83384 18.2614 7.72629 17.9304 7.49061 17.7007L2.1851 12.5291C1.59159 11.9505 1.91909 10.9426 2.73931 10.8234L10.0713 9.75797C10.3971 9.71064 10.6786 9.50607 10.8243 9.21093L14.1033 2.56698Z" fill="#FBBF24"></path>
											</g>
										</g>
										<defs>
											<clipPath id="clip0_13866_9712">
												<rect width="30" height="30" fill="white"></rect>
											</clipPath>
											<clipPath id="clip1_13866_9712">
												<rect width="30" height="30" fill="white"></rect>
											</clipPath>
										</defs>
									</svg>
									
								</div>
								<div class="w-full p-6 ">
									<h5 class="text-xl font-semibold font-manrope text-gray-900 mb-4">@userService.User?.UserName</h5>
									<p class="text-sm font-medium text-gray-600">@userService.Service?.Name </p>
								</div>
							</div>
						}

                   



                       
                       
                  

                    </div>
                </div>
            </div>
        </div>
    </div>
</main>