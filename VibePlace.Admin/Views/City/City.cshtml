@{
}

@model List<City>

@{
    ViewData["Title"] = "Справочник городов";
    ViewData["Description"] = "список городов";
}
<table class="table table-striped table-bordered table-advance table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (City? item in Model)
        {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>
                        <a href="@Url.Action("EditPosition", "Home", new{id=item.Id})">edit</a>
                    </td>
                    <td>
                        <a href="@Url.Action("DeletePosition", "Home", new{id=item.Id})">delete</a>
                    </td>
                </tr>
        }
    </tbody>
</table>

<hr />
<a href="@Url.Action("CreateCity", "City")" class="btn btn-default">Add City</a>
