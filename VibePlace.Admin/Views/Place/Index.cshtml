@{
}
@model List<Places>

@{
    ViewData["Title"] = "Справочник мест";
    ViewData["Description"] = "список мест";
}
<table class="table table-striped table-bordered table-advance table-hover">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Description</th>
            <th>Address</th>
            <th>Price</th>
            <th>Capacity</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Places? item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item?.Description</td>
                <td>@item?.Address</td>
                <td>@item?.Price</td>
                <td>@item?.Capacity</td>
                <td>
                    <a href="@Url.Action("EditPosition", "Home", new{id=item.Id})">edit</a>
                </td>
                <td>
                    <a href="@Url.Action("DeletePosition", "Home", new{id=item.Id})">delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<hr />
<a href="@Url.Action("EditPosition", "Home")" class="btn btn-default">Add Position</a>